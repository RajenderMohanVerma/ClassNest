# Flask
SECRET_KEY=change-me-to-a-random-64-char-string
FLASK_ENV=development
FLASK_DEBUG=1

# PostgreSQL
DATABASE_URL=postgresql://classnest_user:your_password@localhost:5432/classnest_db

# Uploads
UPLOAD_FOLDER=app/static/uploads
MAX_UPLOAD_MB=16

# Branding (easy to change)
APP_NAME=ClassNest
APP_TAGLINE=Teacher & Student Learning Portal
