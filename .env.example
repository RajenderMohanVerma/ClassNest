# Flask
SECRET_KEY=change-me-to-a-random-64-char-string
FLASK_ENV=development
FLASK_DEBUG=1
# Hours a "remember me" session stays valid.
SESSION_HOURS=8

# Supabase PostgreSQL
# Use the Session Pooler URL for Vercel/serverless deployments.
DATABASE_URL=postgresql://postgres.project-ref:password@pooler.supabase.com:5432/postgres?sslmode=require

# Uploads (keep this outside app/static so files need authentication).
# Absolute paths are recommended; relative paths resolve from the project root.
UPLOAD_FOLDER=instance/uploads
MAX_UPLOAD_MB=16

# Rate limiting. Set RATE_LIMIT_STORAGE_URI to a Redis/memcached URI on
# multi-instance or serverless deployments, otherwise limits are per-process.
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_DEFAULT=300 per hour

# Branding
APP_NAME=ClassNext
APP_TAGLINE=Learn • Practice • Achieve
APP_DESCRIPTION=Classes, notes, videos and courses by Er. Amit Sir.
TEACHER_NAME=Er. Amit Sir
# Must match manifest.webmanifest so the browser toolbar matches the installed app
THEME_COLOR=#4f35e8
# Public origin, used for canonical URLs, sitemap.xml, robots.txt and Open Graph.
# Example: https://your-domain.com
SITE_URL=

# Premium courses / payments.
# Premium stays disabled until PAYMENT_KEY_ID and PAYMENT_KEY_SECRET are both
# set, so an incomplete integration can never show a fake payment success.
# PAYMENT_GATEWAY=razorpay
# PAYMENT_CURRENCY=INR
# PAYMENT_KEY_ID=
# PAYMENT_KEY_SECRET=
# PAYMENT_WEBHOOK_SECRET=

# Outbound email for verification and password-reset links.
# Leave MAIL_ENABLED=0 until the SMTP settings below are filled in.
MAIL_ENABLED=0
# MAIL_FROM=no-reply@your-domain.com
# MAIL_SERVER=smtp.your-provider.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
MAIL_USE_TLS=1
# How long a verification / reset link stays usable. Both links work once only.
PASSWORD_RESET_TTL_MINUTES=30