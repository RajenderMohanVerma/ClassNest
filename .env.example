# Flask
SECRET_KEY=change-me-to-a-random-64-char-string
FLASK_ENV=development
FLASK_DEBUG=1
# Hours a "remember me" session stays valid.
SESSION_HOURS=8

# Supabase PostgreSQL
# Use the Session Pooler URL for Vercel/serverless deployments.
DATABASE_URL=postgresql://postgres.project-ref:password@pooler.supabase.com:5432/postgres?sslmode=require

# Uploads (keep this outside app/static so files need authentication).
# Absolute paths are recommended; relative paths resolve from the project root.
UPLOAD_FOLDER=instance/uploads
MAX_UPLOAD_MB=16

# Rate limiting. Set RATE_LIMIT_STORAGE_URI to a Redis/memcached URI on
# multi-instance or serverless deployments, otherwise limits are per-process.
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_DEFAULT=300 per hour

# Branding
APP_NAME=ClassNest
APP_TAGLINE=Teacher & Student Learning Portal
APP_DESCRIPTION=ClassNest - Your Smart Learning Companion
# Must match manifest.webmanifest so the browser toolbar matches the installed app
THEME_COLOR=#4f35e8